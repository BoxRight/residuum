digraph G {
rankdir=LR;
node [fontname="sans-serif", fontsize=10];
"Act" [shape=ellipse, label="Act"];
"compliance" [shape=ellipse, label="compliance"];
"law" [shape=ellipse, label="law"];
"legislationText" [shape=ellipse, label="legislationText"];
"legislativeCapacity" [shape=ellipse, label="legislativeCapacity"];
"legislativePower" [shape=ellipse, label="legislativePower"];
"obligation" [shape=ellipse, label="obligation"];
"obligationFiled" [shape=ellipse, label="obligationFiled"];
"powerGranted" [shape=ellipse, label="powerGranted"];
"right" [shape=ellipse, label="right"];
"rule:capacityPower" [shape=box, label="rule:capacityPower\nrequires every premise"];
"rule:enactLaw" [shape=box, label="rule:enactLaw\nrequires every premise"];
"rule:filedObligation" [shape=box, label="rule:filedObligation\nrequires every premise"];
"rule:grantedCapacity" [shape=box, label="rule:grantedCapacity\nrequires every premise"];
"rule:obligationCompliance" [shape=box, label="rule:obligationCompliance\nrequires every premise"];
"rule:rightCompliance" [shape=box, label="rule:rightCompliance\nrequires every premise"];
"rule:statutoryObligation" [shape=box, label="rule:statutoryObligation\nrequires every premise"];
"Act" -> "rule:enactLaw" [label="premise", fontsize=8];
"Act" -> "rule:obligationCompliance" [label="premise", fontsize=8];
"Act" -> "rule:rightCompliance" [label="premise", fontsize=8];
"law" -> "rule:statutoryObligation" [label="premise", fontsize=8];
"legislationText" -> "rule:enactLaw" [label="premise", fontsize=8];
"legislativeCapacity" -> "rule:capacityPower" [label="premise", fontsize=8];
"legislativePower" -> "rule:enactLaw" [label="premise", fontsize=8];
"obligation" -> "rule:obligationCompliance" [label="premise", fontsize=8];
"obligationFiled" -> "rule:filedObligation" [label="premise", fontsize=8];
"powerGranted" -> "rule:grantedCapacity" [label="premise", fontsize=8];
"right" -> "rule:rightCompliance" [label="premise", fontsize=8];
"rule:capacityPower" -> "legislativePower" [label="consequence", fontsize=8];
"rule:enactLaw" -> "law" [label="consequence", fontsize=8];
"rule:filedObligation" -> "obligation" [label="consequence", fontsize=8];
"rule:grantedCapacity" -> "legislativeCapacity" [label="consequence", fontsize=8];
"rule:obligationCompliance" -> "compliance" [label="consequence", fontsize=8];
"rule:rightCompliance" -> "compliance" [label="consequence", fontsize=8];
"rule:statutoryObligation" -> "obligation" [label="consequence", fontsize=8];
}
