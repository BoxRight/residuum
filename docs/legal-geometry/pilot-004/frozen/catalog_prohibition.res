rule p4c178(a, s, c, o, b, au, e, x, t) =
    Act(a, s, c, o, b, au, e) @ t & ~copresent(s, x) @ t & ~copresent(b, x) @ t
    <= prohibition(hypNorm, s, c, o, b, administrative, hypEnacted) @ t
