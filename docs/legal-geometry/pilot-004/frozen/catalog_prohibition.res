module Pilot004Catalog_prohibition

import "./vocabulary.res"

// Generated by tools/pilot004/generate_catalog.py. Every admissible clause
// of the Pilot 004 grammar with head prohibition and one or two antecedents
// besides the act anchor. Never load these rules as one theory: each
// candidate is evaluated in isolation as LegalGeneral + vocabulary + one rule.

rule p4c001(a, s, c, o, b, au, e, t) =
    Act(a, s, c, o, b, au, e) @ t & condition(s, allergic) @ t
    <= prohibition(hypNorm, s, c, o, b, administrative, hypEnacted) @ t

